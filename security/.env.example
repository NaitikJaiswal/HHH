# ==============================================================================
# HHH / SecureLog — Security & Blockchain Module Environment Configuration
# ==============================================================================
# Copy this file to .env and replace placeholders with your local environment values.
# NEVER commit private keys, secrets, or passphrase files to Git.

# ─── EVM Blockchain Configuration ─────────────────────────────────────────────
# Local Hardhat Node RPC URL (default: http://127.0.0.1:8545)
RPC_URL=http://127.0.0.1:8545
LOGN_RPC_URL=http://127.0.0.1:8545

# EVM Chain ID (31337 for local Hardhat node, 11155111 for Sepolia)
EXPECTED_CHAIN_ID=31337
LOGN_CHAIN_ID=31337

# Deployed SecureLogAnchor smart contract address
# Example: 0x5FbDB2315678afecb367f032d93F642f64180aa3 (from local deploy script)
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
LOGN_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Hex private key for the authorized submitter wallet
# For local Hardhat development: Account #0 private key
# 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BLOCKCHAIN_PRIVATE_KEY=0x_YOUR_EVM_PRIVATE_KEY_HEX_PLACEHOLDER
LOGN_SUBMITTER_PRIVATE_KEY=0x_YOUR_EVM_PRIVATE_KEY_HEX_PLACEHOLDER

# Confirmation timeout for EVM transactions in seconds (default: 60)
LOGN_TX_TIMEOUT_SECONDS=60

# ─── Ed25519 Off-Chain Signing Key Configuration ──────────────────────────────
# Passphrase used by scrypt to encrypt/decrypt security/keys/signing_key.enc
LOGN_KEY_PASSPHRASE=your-strong-passphrase-here
